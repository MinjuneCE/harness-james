{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/require-push-approval.mjs"], "timeout": 10, "onFailure": "block" },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/require-verify-before-pr.mjs"], "timeout": 15, "onFailure": "block" },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/require-pr-flow.mjs"], "timeout": 10, "onFailure": "block" },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/require-pane-account.mjs"], "timeout": 10, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|Agent|Task",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/verify-guard.mjs"], "timeout": 10, "onFailure": "block" }
        ]
      }
    ]
  }
}
